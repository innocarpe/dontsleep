"onboard.welcome.title" = "Welcome to DontSleep";
"onboard.welcome.body1" = "Closing a MacBook lid normally puts the Mac to sleep. DontSleep turns that off when you want the machine to stay awake — on battery or plugged in.";
"onboard.welcome.body2" = "This is not the same as preventing idle sleep. Tools like caffeinate only keep the Mac awake while the lid is already open.";

"onboard.permission.title" = "Allow closed-lid control";
"onboard.permission.why" = "Closed-lid sleep is a system setting. Run the command below in this window — you do not need Terminal.app.";
"onboard.permission.what" = "Your account only; pmset -a disablesleep 1 and 0 only. macOS asks for a password once (Touch ID works).";
"onboard.permission.cmdOn" = "pmset -a disablesleep 1   stay awake with the lid closed";
"onboard.permission.cmdOff" = "pmset -a disablesleep 0   sleep when the lid closes";
"onboard.permission.scope" = "Nothing else in sudo is unlocked. Remove later with sudo rm /etc/sudoers.d/dontsleep.";
"onboard.permission.hint" = "Press Enter to run the command.";
"onboard.permission.copy" = "Copy";
"onboard.permission.copied" = "Copied";
"onboard.permission.success" = "wrote /etc/sudoers.d/dontsleep";

